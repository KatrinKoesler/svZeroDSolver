{
  "description": {
    "description of test case": "runs a simple 0D model of a cardiac chamber with inlet and outlet valves"
  },
  "boundary_conditions": [
    {
      "bc_name": "IN",
      "bc_type": "PRESSURE",
      "bc_values": {
        "P": [2000, 2000],
        "t": [0, 1]
      }
    },
    {
      "bc_name": "OUT",
      "bc_type": "PRESSURE",
      "bc_values": {
        "P": [1000, 1000],
        "t": [0, 1]
      }
    },
    {
      "bc_name": "IN1",
      "bc_type": "PRESSURE",
      "bc_values": {
        "P": [2000, 2000],
        "t": [0, 1]
      }
    },
    {
      "bc_name": "OUT1",
      "bc_type": "PRESSURE",
      "bc_values": {
        "P": [1000, 1000],
        "t": [0, 1]
      }
    }
  ],
  "simulation_parameters": {
    "number_of_cardiac_cycles": 20,
    "number_of_time_pts_per_cardiac_cycle": 1000,
    "steady_initial": false,
    "output_variable_based": true,
    "absolute_tolerance": 1e-9,
    "output_all_cycles": true
  },
  "vessels": [
    {
      "boundary_conditions": {
        "inlet": "IN"
      },
      "vessel_id": 0,
      "vessel_length": 2.0,
      "vessel_name": "upstream_vessel",
      "zero_d_element_type": "BloodVessel",
      "zero_d_element_values": {
        "R_poiseuille": 100.0,
        "C": 1.0e-7
      }
    },
    {
      "boundary_conditions": {
        "outlet": "OUT"
      },
      "vessel_id": 1,
      "vessel_length": 1.0,
      "vessel_name": "downstream_proximal_vessel",
      "zero_d_element_type": "BloodVessel",
      "zero_d_element_values": {
        "R_poiseuille": 8.0e6,
        "C": 2.5e-9
      }
    },
    {
      "boundary_conditions": {
        "inlet": "IN1"
      },
      "vessel_id": 2,
      "vessel_length": 1.0,
      "vessel_name": "downstream_distal_vessel",
      "zero_d_element_type": "BloodVessel",
      "zero_d_element_values": {
        "R_poiseuille": 1.0e8,
        "C": 1.0e-8
      }
    },
    {
      "boundary_conditions": {
        "outlet": "OUT1"
      },
      "vessel_id": 3,
      "vessel_length": 1.0,
      "vessel_name": "downstream_proximal_vessel",
      "zero_d_element_type": "BloodVessel",
      "zero_d_element_values": {
        "R_poiseuille": 8.0e6,
        "C": 2.5e-9
      }
    }
  ],
  "junctions": [
    {
      "inlet_vessels": [0],
      "junction_name": "J0",
      "junction_type": "NORMAL_JUNCTION",
      "outlet_vessels": [1]
    },
    {
      "inlet_vessels": [2],
      "junction_name": "J1",
      "junction_type": "NORMAL_JUNCTION",
      "outlet_vessels": [3]
    }
  ]
}
